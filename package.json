{
  "name": "tcg-master-set",
  "version": "0.1.2",
  "private": true,
  "description": "A cozy single-player 3D game about opening booster packs and completing master set binders.",
  "repository": "github:MathieuMamath/tcg-master-set",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome check .",
    "format": "biome check --write .",
    "release": "commit-and-tag-version",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "lefthook",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commit-and-tag-version": "^13.3.0",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1"
  }
}
