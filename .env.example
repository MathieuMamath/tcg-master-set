# Copy to .env.local for local development. In production, the host sets the same variables,
# with DATABASE_URL connecting as tcg_app (see db/prod-runtime-role.sql).
DATABASE_URL=postgresql://tcg:dev_only_password@localhost:5433/tcg_master_set_dev

# Signs session cookies. Generate your own with: openssl rand -hex 32
AUTH_SECRET=

# The address the game is served from: the public one in production, for sign-in and the
# previews of shared links.
APP_URL=http://localhost:3000

# Emails, such as password reset links, go through Scaleway Transactional Email once these three
# are set. Without them, development prints each email in the server's output, and production
# hides password reset. EMAIL_FROM's domain must be verified in Scaleway.
# SCALEWAY_SECRET_KEY=
# SCALEWAY_PROJECT_ID=
# EMAIL_FROM=no-reply@tcg-master-set.example.com

# Optional, comma-separated: other addresses allowed to sign in, such as a phone on your network.
# TRUSTED_ORIGINS=http://192.168.1.10:3000
