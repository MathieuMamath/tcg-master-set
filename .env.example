# Copy to .env.local for local development.
DATABASE_URL=postgresql://tcg:dev_only_password@localhost:5433/tcg_master_set_dev

# Signs session cookies. Generate your own with: openssl rand -hex 32
AUTH_SECRET=

# The address the game is served from.
APP_URL=http://localhost:3000

# Optional, comma-separated: other addresses allowed to sign in, such as a phone on your network.
# TRUSTED_ORIGINS=http://192.168.1.10:3000
